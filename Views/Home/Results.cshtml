@model IEnumerable<DrAshrafMellouli.Models.Result>
@{
    ViewData["Title"] = "Avant & Après - Les Jasmins Centre de Dermatologie";
}
<!-- ATMOSPHERIC JOURNEY NAVIGATION: FLOATING GLASS PILL -->
<div class="journey-glass-nav" id="journeyNav">
    <a href="#hero" class="journey-link active" data-section="hero">ACCUEIL</a>
    <a href="#gallery" class="journey-link" data-section="gallery">RÉSULTATS</a>
    <a href="#validation" class="journey-link" data-section="validation">ÉTUDES DE CAS</a>
    <a href="#faq" class="journey-link" data-section="faq">FAQ</a>
</div>

<section id="hero" class="treatment-clinical-split">
    <div class="clinical-split-sculpture">
        <!-- Left Side: Technical Data -->
        <div class="clinical-data-column reveal-on-scroll">
            <div class="data-badge">ARCHIVE : MÉTAMORPHOSE</div>
            <div class="data-readout">
                <span>CAS TOTAUX : 1,240+</span>
                <span>TYPE : PREUVE CLINIQUE</span>
                <span>v5.0.0</span>
            </div>
            <h1 class="clinical-title">
                L'ART DU <br>
                <span class="gold-italic">RÉSULTAT</span>
            </h1>
            <p class="clinical-lead">
                Une archive transparente de transformations. Où la précision mathématique rencontre l'harmonie visible.
            </p>
            
            <div class="clinical-abstract-mesh"></div>
        </div>

        <!-- Right Side: Ethereal Portrait -->
        <div class="clinical-visual-column">
            <img class="clinical-portrait-img" src="/images/clinical_symmetry_hero.png" alt="Clinical Results">
            <div class="visual-scan-line"></div>
            <div class="visual-topo-overlay"></div>
            <div class="visual-corner-tags">
                <span>PREUVE</span>
                <span>HARMONIE</span>
            </div>
        </div>
    </div>

    <div class="clinical-scroll-indicator">
        <span class="scroll-label">EXPLORER LA GALERIE</span>
        <div class="scroll-monolith-line"></div>
    </div>
</section>

<!-- RESULTS GALLERY SECTION -->
</section>

<!-- RESULTS GALLERY SECTION -->
<section id="gallery" class="metamorphosis-lab section-padding" style="background: #000; color: #fff;">
    <div class="lab-container">
        <!-- Filter Controls -->
        <div class="lab-filter-bar reveal-on-scroll">
            <button class="filter-btn active" data-filter="all">TOUS</button>
            <button class="filter-btn" data-filter="visage">VISAGE</button>
            <button class="filter-btn" data-filter="corps">CORPS</button>
            <button class="filter-btn" data-filter="laser">LASER</button>
            <button class="filter-btn" data-filter="cheveux">CHEVEUX</button>
        </div>

        <div class="lab-grid" id="resultsGrid">
            @if (Model != null && Model.Any())
            {
                int delay = 0;
                foreach (var item in Model)
                {
                    string catSlug = item.Category switch {
                        DrAshrafMellouli.Models.Category.Face => "visage",
                        DrAshrafMellouli.Models.Category.Body => "corps",
                        DrAshrafMellouli.Models.Category.Hair => "cheveux",
                        DrAshrafMellouli.Models.Category.Laser => "laser",
                        _ => "visage"
                    };
                    <article class="transformation-card reveal-on-scroll result-item" data-category="@catSlug" style="transition-delay: @(delay * 0.1)s;">
                        <div class="transformation-visual">
                            <div class="image-pair">
                                <div class="img-before" style="background-image: url('@item.BeforeImageUrl');">
                                    <span class="img-label">AVANT</span>
                                </div>
                                <div class="img-after" style="background-image: url('@item.AfterImageUrl');">
                                    <span class="img-label">APRES</span>
                                </div>
                            </div>
                            <div class="comparison-slider-handle"></div>
                        </div>
                        <div class="transformation-info">
                            <div class="info-header">
                                <span class="info-case">ID DU CAS : #@item.Id.ToString("D4")</span>
                                <span class="info-protocol">@item.ProtocolName</span>
                            </div>
                            <h3 class="info-title">@item.Title</h3>
                            <p class="info-desc">@item.Description</p>
                            <div class="info-footer" style="font-size: 0.7rem; opacity: 0.5; margin-top: 8px;">
                                <span>@item.Sessions</span> | <span>@item.ResultType</span>
                            </div>
                        </div>
                    </article>
                    delay++;
                }
            }
            else
            {
                <!-- Fallback to static if no data in DB yet -->
                <!-- Case 01: Visage (Hydrafacial) -->
                <article class="transformation-card reveal-on-scroll result-item" data-category="visage">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/hydrafacial_before.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/hydrafacial_after.png');">
                                <span class="img-label">APRES</span>
                            </div>
                        </div>
                        <div class="comparison-slider-handle"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #V-882</span>
                            <span class="info-protocol">HYDRAFACIAL MD</span>
                        </div>
                        <h3 class="info-title">Éclat & Pureté</h3>
                        <p class="info-desc">Nettoyage profond et infusion de sérums pour une peau instantanément régénérée et lumineuse.</p>
                    </div>
                </article>

                <!-- Case 02: Injections -->
                <article class="transformation-card reveal-on-scroll result-item" data-category="visage" style="transition-delay: 0.1s;">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/injections_before.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/injections_after.png');">
                                <span class="img-label">APRES</span>
                            </div>
                        </div>
                        <div class="comparison-slider-handle"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #I-120</span>
                            <span class="info-protocol">RESTAURATION VOLUMÉTRIQUE</span>
                        </div>
                        <h3 class="info-title">Restauration des Volumes</h3>
                        <p class="info-desc">Comblement des sillons nasogéniens avec de l'acide hyaluronique pour un visage reposé.</p>
                    </div>
                </article>

                <!-- Case 03: Laser -->
                <article class="transformation-card reveal-on-scroll result-item" data-category="laser" style="transition-delay: 0.2s;">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/injections_before.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/injections_after.png');">
                                <span class="img-label">APRES</span>
                            </div>
                        </div>
                        <div class="comparison-slider-handle"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #L-402</span>
                            <span class="info-protocol">LASER VASCULAIRE</span>
                        </div>
                        <h3 class="info-title">Éclat Vasculaire</h3>
                        <p class="info-desc">Élimination des rougeurs diffuses et des petits vaisseaux par laser YAG.</p>
                    </div>
                </article>

                <!-- Case 04: Cheveux -->
                <article class="transformation-card reveal-on-scroll result-item" data-category="cheveux" style="transition-delay: 0.3s;">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/hydrafacial_before.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/hydrafacial_after.png');">
                                <span class="img-label">APRES</span>
                            </div>
                        </div>
                        <div class="comparison-slider-handle"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #H-301</span>
                            <span class="info-protocol">CAPILLAIRE & VISAGE</span>
                        </div>
                        <h3 class="info-title">Densification & Éclat</h3>
                        <p class="info-desc">Une approche globale combinant la nutrition profonde du derme et la revitalisation.</p>
                    </div>
                </article>
            }
        </div>

    </div>
</section>

</section>

<section id="validation" class="tech-metrics-section">
    <div class="gallery-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">ÉTUDES DE <br> <em>CAS CLINIQUES</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="metrics-grid">
            <div class="metric-card reveal-on-scroll">
                <span class="metric-num">DONNÉE 01</span>
                <h3 class="metric-title">SUIVI CLINIQUE</h3>
                <p class="metric-desc">Chaque cas est documenté par une photographie médicale standardisée et des mesures d'analyse de la peau objectives pour assurer une évolution transparente.</p>
            </div>
            <div class="metric-card reveal-on-scroll" style="transition-delay: 0.1s;">
                <span class="metric-num">DONNÉE 02</span>
                <h3 class="metric-title">HARMONIE ESTHÉTIQUE</h3>
                <p class="metric-desc">Les résultats sont mesurés par rapport au Nombre d'Or (Phi) pour maintenir l'équilibre anatomique et éviter un aspect "trop traité".</p>
            </div>
            <div class="metric-card reveal-on-scroll" style="transition-delay: 0.2s;">
                <span class="metric-num">DONNÉE 03</span>
                <h3 class="metric-title">RÉFÉRENCES MONDIALES</h3>
                <p class="metric-desc">Nos taux de réussite et résultats cliniques sont recoupés avec les standards esthétiques internationaux de Paris et Monaco.</p>
            </div>
        </div>
    </div>
</section>

</section>

<section id="faq" class="faq-clinical">
    <div class="faq-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">QUESTIONS <br> <em>FRÉQUENTES</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="faq-list">
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">S'agit-il de vrais patients du Centre Les Jasmins ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        Oui, chaque image de notre galerie représente un vrai patient traité personnellement au sein de notre centre Les Jasmins sous la supervision du Dr Ashraaf Mellouli Laroussi.
                    </div>
                </div>
            </div>
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Pourquoi certains résultats mettent-ils plus de temps à apparaître ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        Alors que les injections montrent un changement immédiat, les traitements régénératifs comme le Laser CO2 ou les protocoles capillaires dépendent des cycles de renouvellement cellulaire, qui prennent généralement 4 à 12 semaines pour un effet visible complet.
                    </div>
                </div>
            </div>
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Puis-je obtenir ces résultats en une seule séance ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        De nombreux cas "Visage" sont des transformations en une seule séance. Cependant, les protocoles "Corps" et "Laser" nécessitent souvent une série calculée de traitements pour atteindre le résultat documenté.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

