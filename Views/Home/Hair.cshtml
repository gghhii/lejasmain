@model IEnumerable<DrAshrafMellouli.Models.Treatment>
@{
    ViewData["Title"] = "Traitement Cheveux - Les Jasmins";
}
<!-- ATMOSPHERIC JOURNEY NAVIGATION: FLOATING GLASS PILL -->
<div class="journey-glass-nav" id="journeyNav">
    <a href="#hero" class="journey-link active" data-section="hero">ACCUEIL</a>
    <a href="#protocols" class="journey-link" data-section="protocols">TRAITEMENTS</a>
    <a href="#expertise" class="journey-link" data-section="expertise">TECHNOLOGIES</a>
    <a href="#results" class="journey-link" data-section="results">RÉSULTATS</a>
    <a href="#journey" class="journey-link" data-section="journey">DÉROULEMENT</a>
    <a href="#faq" class="journey-link" data-section="faq">FAQ</a>
</div>

<section id="hero" class="treatment-clinical-split">
    <div class="clinical-split-sculpture">
        <!-- Left Side: Technical Data -->
        <div class="clinical-data-column reveal-on-scroll">
            <div class="data-badge">PROTOCOLE : CHEVEUX</div>
            <div class="data-readout">
                <span>COORD : 18.003</span>
                <span>TYPE : RÉGÉNÉRATIF</span>
                <span>v3.0.1</span>
            </div>
            <h1 class="clinical-title">
                RÉGÉNÉRATION <br>
                <span class="gold-italic">VITALE</span>
            </h1>
            <p class="clinical-lead">
                Protocoles scientifiques pour la densité capillaire et la santé du cuir chevelu, fusionnant la bio-ingénierie et les soins cliniques.
            </p>
            
            <div class="clinical-abstract-mesh"></div>
        </div>

        <!-- Right Side: Ethereal Portrait -->
        <div class="clinical-visual-column">
            <img class="clinical-portrait-img" src="/images/hair.png" alt="Hair Treatment">
            <div class="visual-scan-line"></div>
            <div class="visual-topo-overlay"></div>
            <div class="visual-corner-tags">
                <span>FOLLICULAIRE</span>
                <span>DENSITÉ</span>
            </div>
        </div>

    </div>

    <div class="clinical-scroll-indicator">
        <span class="scroll-label">PROTOCOLES SÉLECTIONNÉS</span>
        <div class="scroll-monolith-line"></div>
    </div>
</section>


<section id="protocols" class="treatment-gallery-sculpture section-padding">
    <div class="gallery-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">TRAITEMENTS <br> <em>CAPILLAIRES</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="treatment-discovery-bar reveal-on-scroll">
            <div class="search-wrapper">
                <input type="text" class="search-input" placeholder="RECHERCHER UN SOIN..." id="hairSearch">
                <div class="search-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
                <div class="search-scanner-line"></div>
            </div>
        </div>

        <div class="treatment-matrix">
            @if (Model != null && Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <div class="matrix-item reveal-on-scroll" style="transition-delay: @(0.1 * (i-1))s;">
                        <div class="matrix-visual">
                            <img src="@item.ImageUrl" alt="@item.Title">
                            <div class="matrix-overlay"></div>
                            <span class="matrix-num">@i.ToString("D2")</span>
                        </div>
                        <div class="matrix-content">
                            <h3 class="matrix-name">@item.Title</h3>
                            <p class="matrix-desc">@item.Description</p>
                            <a href="/Home/Treatment/@item.Id" class="matrix-link">DÉTAILS DU PROTOCOLE →</a>
                        </div>
                    </div>
                    i++;
                }
            }
            else
            {
                <!-- Fallback to static if no data in DB yet -->
                <!-- Treatment 1: Medical & Surgical -->
                <div class="matrix-item reveal-on-scroll">
                    <div class="matrix-visual">
                        <img src="/images/hair1.jpg" alt="Traitement Médical">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">01</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">TRAITEMENT MÉDICAL ET CHIRURGICAL DES CHEVEUX</h3>
                        <p class="matrix-desc">Prise en charge complète pour la restauration et la santé globale de la chevelure.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- Treatment 2: Alopecia -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.1s;">
                    <div class="matrix-visual">
                        <img src="/images/hair2.jpg" alt="Alopécie">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">02</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">TRAITEMENT DES ALOPÉCIES CICATRICIELLES</h3>
                        <p class="matrix-desc">Protocoles spécialisés pour stabiliser et traiter les pertes de cheveux cicatricielles.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- Treatment 3: Pelade -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.2s;">
                    <div class="matrix-visual">
                        <img src="/images/hair3.jpg" alt="Pelade">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">03</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">TRAITEMENT PELADE</h3>
                        <p class="matrix-desc">Soins ciblés pour la repousse des zones touchées par la pelade (alopecia areata).</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- Treatment 4: PRP -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.3s;">
                    <div class="matrix-visual">
                        <img src="/images/hair4.jpg" alt="PRP">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">04</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">INJECTION DE PRP (PLASMA RICHE EN PLAQUETTES)</h3>
                        <p class="matrix-desc">Biostimulation autologue pour densifier et fortifier les follicules pileux.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- Treatment 5: Mycoses -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.4s;">
                    <div class="matrix-visual">
                        <img src="/images/hair5.jpg" alt="Mycoses">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">05</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">TRAITEMENT DES MYCOSES DU CUIR CHEVELU (TEIGNES)</h3>
                        <p class="matrix-desc">Diagnostic et traitement dermatologique des infections fongiques capillaires.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>
            }
        </div>


        <div id="noHairResults" class="no-results-msg">Aucun soin ne correspond à votre recherche.</div>

        <script>
            document.getElementById('hairSearch').addEventListener('input', function(e) {
                const term = e.target.value.toLowerCase();
                const items = document.querySelectorAll('.matrix-item');
                let hasResults = false;
                
                items.forEach(item => {
                    const title = item.querySelector('.matrix-name').textContent.toLowerCase();
                    const desc = item.querySelector('.matrix-desc').textContent.toLowerCase();
                    
                    if (title.includes(term) || desc.includes(term)) {
                        item.classList.remove('hidden');
                        hasResults = true;
                    } else {
                        item.classList.add('hidden');
                    }
                });
                
                document.getElementById('noHairResults').style.display = hasResults ? 'none' : 'block';
            });
        </script>
    </div>
</section>

</section>

<section id="expertise" class="tech-metrics-section">
    <div class="gallery-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">TECHNOLOGIES <br> <em>& PRODUITS</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="metrics-grid">
            <div class="metric-card reveal-on-scroll">
                <span class="metric-num">MESURE 01</span>
                <h3 class="metric-title">BIO-STIMULATION</h3>
                <p class="metric-desc">Nous utilisons du plasma autologue (PRP) concentré par centrifugation de haute précision pour maximiser l'apport de facteurs de croissance.</p>
            </div>
            <div class="metric-card reveal-on-scroll" style="transition-delay: 0.1s;">
                <span class="metric-num">MESURE 02</span>
                <h3 class="metric-title">SYNERGIE NUTRACEUTIQUE</h3>
                <p class="metric-desc">Nos cocktails de mésothérapie sont mélangés sur mesure avec des vitamines et des peptides de haute puissance pour réparer les unités folliculaires.</p>
            </div>
            <div class="metric-card reveal-on-scroll" style="transition-delay: 0.2s;">
                <span class="metric-num">MESURE 03</span>
                <h3 class="metric-title">PHOTOMODULATION LED</h3>
                <p class="metric-desc">Thérapie LED de qualité clinique à des longueurs d'onde spécifiques pour stimuler la production d'ATP cellulaire et la micro-circulation du cuir chevelu.</p>
            </div>
        </div>
    </div>
</section>

</section>

<section id="results" class="transformation-showcase section-padding">
    <div class="showcase-container">
        <header class="showcase-header reveal-on-scroll">
            <span class="showcase-label">ÉTUDE DE CAS: #H-440</span>
            <h2 class="showcase-title">DENSITÉ & <br> <em>VITALITÉ RÉTABLIES</em></h2>
        </header>

        <div class="cinematic-reveal reveal-on-scroll">
            <img src="/images/hair_transformation.png" alt="Hair Transformation">
            <div class="reveal-labels">
                <span class="reveal-label">AVANT</span>
                <span class="reveal-label">APRÈS</span>
            </div>
        </div>

        <div class="showcase-footer reveal-on-scroll">
            <div class="footer-metadata">
                <span class="metadata-item">PROTOCOLE: <span>BIOCAPILLAIRE PRP+</span></span>
                <span class="metadata-item">SESSIONS: <span>3 CYCLES</span></span>
                <span class="metadata-item">RÉSULTAT: <span>DURABLE</span></span>
            </div>
            <a href="/Home/Results" class="showcase-cta">VOIR LA GALERIE CLINIQUE →</a>
        </div>
    </div>
</section>

</section>

<section id="journey" class="procedure-journey">
    <div class="journey-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">DÉROULEMENT <br> <em>DU SOIN</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="journey-steps">
            <div class="journey-step reveal-on-scroll">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 01</span>
                <h3 class="step-title">TRICHOLOGIE</h3>
                <p class="step-text">Analyse microscopique du cuir chevelu et de la densité capillaire pour identifier la cause profonde de l'amincissement.</p>
            </div>
            <div class="journey-step reveal-on-scroll" style="transition-delay: 0.1s;">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 02</span>
                <h3 class="step-title">EXTRACTION</h3>
                <p class="step-text">Pour le PRP, un prélèvement sanguin précis suivi d'une séparation avancée des facteurs de croissance les plus riches.</p>
            </div>
            <div class="journey-step reveal-on-scroll" style="transition-delay: 0.2s;">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 03</span>
                <h3 class="step-title">INFUSION</h3>
                <p class="step-text">Micro-injections ou systèmes d'administration non invasifs ciblés directement au niveau du bulbe.</p>
            </div>
            <div class="journey-step reveal-on-scroll" style="transition-delay: 0.3s;">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 04</span>
                <h3 class="step-title">VITALITÉ</h3>
                <p class="step-text">Augmentation progressive de l'épaisseur et de la densité des cheveux observée au cours des mois suivants.</p>
            </div>
        </div>
    </div>
</section>

</section>

<section id="faq" class="faq-clinical">
    <div class="faq-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">QUESTIONS <br> <em>FRÉQUENTES</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="faq-list">
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Ces traitements sont-ils adaptés à une calvitie avancée ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        Ces protocoles sont plus efficaces pour l'amincissement des cheveux et l'alopécie au stade précoce. Pour les zones complètement chauves, une greffe peut être nécessaire, que ces traitements peuvent ensuite soutenir.
                    </div>
                </div>
            </div>
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Quand vais-je voir des résultats ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        La croissance des cheveux est un processus biologique. Vous remarquerez peut-être moins de perte après 2-3 séances, avec des améliorations visibles de la densité apparaissant généralement après 3-4 mois.
                    </div>
                </div>
            </div>
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Le traitement est-il douloureux ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        La philosophie du centre Les Jasmins, sous la direction du Dr Ashraaf Mellouli Laroussi, privilégie des protocoles médicaux rigoureux (PRP, mésothérapie) pour restaurer la densité capillaire de manière durable et naturelle.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

