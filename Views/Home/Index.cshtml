<style>
    .metamorphosis-lab {
        width: 100vw !important;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw !important;
        margin-right: -50vw !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        overflow: hidden;
    }

    .lab-container-edge {
        width: 100%;
        max-width: 100%;
        padding: 0;
        margin: 0;
        box-sizing: border-box;
    }

    .full-slider-wrapper-edge {
        position: relative;
        width: 100%;
        margin-bottom: 4rem;
        display: flex;
        align-items: center;
    }

    .slider-arrow-btn {
        position: absolute;
        top: 35%;
        z-index: 50;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #0d0d0d;
        border: 2px solid var(--color-gold, #c6a87c);
        color: var(--color-gold, #c6a87c);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.7);
    }

    .slider-arrow-left {
        left: 25px;
    }

    .slider-arrow-right {
        right: 25px;
    }

    .slider-arrow-btn:hover {
        background: var(--color-gold, #c6a87c);
        color: #000;
        box-shadow: 0 0 40px rgba(198, 168, 124, 0.8);
        transform: scale(1.15);
    }

    .lab-carousel-scroller {
        display: flex;
        gap: 0;
        width: 100%;
        padding: 15px 0 2rem 0;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        cursor: grab;
        user-select: none;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
    }

    .lab-carousel-scroller::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
    }

    .lab-carousel-scroller.dragging {
        cursor: grabbing;
        scroll-behavior: auto;
        scroll-snap-type: none;
    }

    .lab-carousel-scroller .transformation-card {
        flex: 0 0 50vw;
        width: 50vw;
        max-width: 50vw;
        padding: 0 25px;
        box-sizing: border-box;
        scroll-snap-align: start;
    }

    @@media (max-width: 900px) {
        .slider-arrow-left {
            left: 10px;
        }
        .slider-arrow-right {
            right: 10px;
        }
        .slider-arrow-btn {
            width: 46px;
            height: 46px;
        }
        .lab-carousel-scroller .transformation-card {
            flex: 0 0 100vw;
            width: 100vw;
            max-width: 100vw;
            padding: 0 15px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.slider-dot');
        let currentSlide = 0;
        const slideInterval = 8000;

        function updateSlider(index) {
            slides.forEach(s => s.classList.remove('last-active'));
            const currentActive = document.querySelector('.hero-slide.active');
            if(currentActive) {
                currentActive.classList.replace('active', 'last-active');
            }

            dots.forEach(d => d.classList.remove('active'));
            dots[index].classList.add('active');
            
            slides[index].classList.add('active');
            currentSlide = index;
        }

        function nextSlide() {
            let next = (currentSlide + 1) % slides.length;
            updateSlider(next);
        }

        let autoSlide = setInterval(nextSlide, slideInterval);

        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                clearInterval(autoSlide);
                updateSlider(index);
                autoSlide = setInterval(nextSlide, slideInterval);
            });
        });

        // Full-Width Results Slider: Floating Side Arrows & Mouse Drag
        const scroller = document.getElementById("labScroller");
        const prevBtn = document.getElementById("labPrevBtn");
        const nextBtn = document.getElementById("labNextBtn");

        if (scroller) {
            const getScrollAmount = () => {
                const card = scroller.querySelector('.transformation-card');
                return card ? card.offsetWidth : (scroller.clientWidth / 2);
            };

            if (prevBtn) {
                prevBtn.addEventListener("click", () => {
                    scroller.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
                });
            }
            if (nextBtn) {
                nextBtn.addEventListener("click", () => {
                    scroller.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
                });
            }

            // Mouse Drag to Scroll Left & Right
            let isDown = false;
            let startX;
            let scrollLeft;

            scroller.addEventListener('mousedown', (e) => {
                isDown = true;
                scroller.classList.add('dragging');
                startX = e.pageX - scroller.offsetLeft;
                scrollLeft = scroller.scrollLeft;
            });

            scroller.addEventListener('mouseleave', () => {
                isDown = false;
                scroller.classList.remove('dragging');
            });

            scroller.addEventListener('mouseup', () => {
                isDown = false;
                scroller.classList.remove('dragging');
            });

            scroller.addEventListener('mousemove', (e) => {
                if(!isDown) return;
                e.preventDefault();
                const x = e.pageX - scroller.offsetLeft;
                const walk = (x - startX) * 1.8;
                scroller.scrollLeft = scrollLeft - walk;
            });
        }
    });
</script>


