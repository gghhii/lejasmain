@model DrAshrafMellouli.Models.HomeViewModel
<!-- ATMOSPHERIC JOURNEY NAVIGATION: FLOATING GLASS PILL -->
<div class="journey-glass-nav" id="journeyNav">
    <a href="#hero" class="journey-link active" data-section="hero">ACCUEIL</a>
    <a href="#about" class="journey-link" data-section="about">À PROPOS</a>
    <a href="#traitements" class="journey-link" data-section="traitements">TRAITEMENTS</a>
    <a href="#resultats" class="journey-link" data-section="resultats">CAS CLINIQUES</a>
    <a href="#expertise" class="journey-link" data-section="expertise">PHILOSOPHIE</a>
    <a href="#journal" class="journey-link" data-section="journal">PUBLICATIONS</a>
</div>

<div class="bokeh-container">
    <div class="bokeh-orb" style="width: 400px; height: 400px; top: 10%; right: 15%;"></div>
    <div class="bokeh-orb" style="width: 600px; height: 600px; bottom: 5%; left: 10%; animation-delay: -3s;"></div>
    <div class="bokeh-orb" style="width: 300px; height: 300px; top: 60%; right: 5%; animation-delay: -7s;"></div>
</div>

<section id="hero" class="hero-cinematic-experience">
    <div class="hero-slider-container">
        <div class="hero-vignette"></div>
        <div class="hero-noise-layer"></div>
        <div class="hero-technical-grid"></div>
        <div class="hero-scanner-line"></div>
        
        <div class="hero-slide active" style="background-image: url('/images/slide1.png');"></div>
    </div>

    <div class="hero-overlay-content">
        <div class="hero-branding-eyebrow reveal-on-scroll">
            <span>LES JASMINS</span>
            <span class="eyebrow-dot"></span>
            <span>CENTRE DE DERMATOLOGIE ESTHÉTIQUE</span>
        </div>

        <h1 class="hero-main-title reveal-on-scroll">
            <span class="reveal-line"><span>DERMATOLOGIE</span></span>
            <span class="reveal-line"><span class="title-italic-accent">ESTHÉTIQUE</span></span>
        </h1>

        <p class="hero-lead-text reveal-on-scroll">
            L'alliance parfaite de l'ingénierie médicale d'avant-garde et de l'harmonie architecturale. 
            Découvrez nos protocoles exclusifs pour révéler votre signature esthétique.
        </p>

        <div class="hero-actions-center reveal-on-scroll">
            <a href="#traitements" class="cta-primary-luxury">NOTRE COLLECTION DE SOINS</a>
            <div class="hero-location-inline">
                <span>KANTAOUI MEDICAL CENTER</span><span class="location-dot">·</span><span>SOUSSE</span>
            </div>
        </div>
    </div>

    <div class="hero-slider-dots">
        <div class="slider-dot active"></div>
        <div class="slider-dot"></div>
        <div class="slider-dot"></div>
        <div class="slider-dot"></div>
    </div>

    <div class="hero-scroll-monolith">
        <div class="monolith-line"></div>
        <span class="monolith-text">EXPLORER</span>
    </div>
</section>

<section id="about" class="editorial-about">
    <div class="editorial-container">
        <div class="editorial-visual-sculp reveal-on-scroll">
            <div class="visual-canvas dual-concept">
                <div class="canvas-split">
                    <img src="/images/dr2.jpg" alt="Dr Ashraaf" class="split-portrait portrait-left">
                    <img src="/images/drnesrine.jpg" alt="Dr Nesrine" class="split-portrait portrait-right">
                </div>
                <div class="glass-caption">CO-FONDATRICES</div>
                <div class="floating-mathematics">
                    <svg viewBox="0 0 100 100" class="golden-spiral">
                        <path d="M0,0 C62,0 100,38 100,100" fill="none" stroke="#c6a87c" stroke-width="0.5" opacity="0.4"/>
                    </svg>
                </div>
            </div>
            <div class="visual-label-float">
                <span class="label-large">21+</span>
                <span class="label-sub">ANNÉES D'EXPERTISE <br> CUMULÉE</span>
            </div>
        </div>

        <div class="editorial-copy">
            <div class="editorial-eyebrow reveal-on-scroll">APPROCHE BINCÉPHALE</div>
            
            <h2 class="editorial-title reveal-on-scroll">
                DEUX EXPERTES, <br>
                <em>UNE VISION COMMUNE</em>
            </h2>
            
            <div class="editorial-divider reveal-on-scroll"></div>
            
            <div class="editorial-text-wrap reveal-on-scroll">
                <p>
                    Au cœur du <strong>Kantaoui Medical Center</strong> de Sousse, le centre <strong>Les Jasmins</strong> incarne l'excellence d'une pratique dermatologique partagée.
                </p>
                <p>
                    Co-fondé par le <strong>Dr Ashraaf Mellouli Laroussi</strong> et le <strong>Dr Nesrine Kenani Kassassi</strong>, notre centre fusionne la rigueur scientifique avec une vision architecturale de la beauté. Ensemble, elles offrent une prise en charge bincéphale unique à Sousse.
                </p>
            </div>

            <div class="editorial-matrix reveal-on-scroll">
                <div class="editorial-item">
                    <span class="editorial-num">01</span>
                    <span class="editorial-name">MÉDECINE</span>
                </div>
                <div class="editorial-item">
                    <span class="editorial-num">02</span>
                    <span class="editorial-name">SENSIBILITÉ</span>
                </div>
                <div class="editorial-item">
                    <span class="editorial-num">03</span>
                    <span class="editorial-name">INNOVATION</span>
                </div>
            </div>


        </div>
    </div>
</section>

<div class="arch-divider"></div>

<section id="traitements" class="lx-section">

    <div class="lx-list-integrated" id="lxList">
        <div class="lx-intro-inline">
            <p class="lx-intro__eyebrow">PROTOCOLES MÉDICAUX</p>
            <div class="lx-intro-title-wrap">
                <h2 class="lx-intro__title">NOS <em>TRAITEMENTS</em></h2>
                <div class="lx-counter-block">
                    <span class="lx-counter-current" id="lxCounterCurrent">01</span>
                    <span class="lx-counter-sep">/</span>
                    <span class="lx-counter-total">04</span>
                </div>
            </div>
        </div>

        <div class="lx-item lx-item--active" data-index="01" data-label="Visage">
            <div class="lx-item__bar"></div>
            <div class="lx-item__visual">
                <img src="/images/face.png" alt="Visage">
                <div class="lx-img-overlay"></div>
                <div class="lx-img-label">Visage</div>
            </div>
            <div class="lx-item__inner">
                <span class="lx-item__num">01</span>
                <div class="lx-item__text-content">
                    <h3 class="lx-item__name">Visage</h3>
                    <p class="lx-item__sub">Architecture Faciale</p>
                </div>
                <p class="lx-item__desc">Injections de Botox, Acide Hyaluronique, Mésolift et Microneedling pour une harmonie parfaite.</p>
                <a href="/Home/Face" class="lx-item__cta">Découvrir <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></a>
            </div>
        </div>

        <div class="lx-item" data-index="02" data-label="Cheveux">
            <div class="lx-item__bar"></div>
            <div class="lx-item__visual">
                <img src="/images/hair.png" alt="Cheveux">
                <div class="lx-img-overlay"></div>
                <div class="lx-img-label">Cheveux</div>
            </div>
            <div class="lx-item__inner">
                <span class="lx-item__num">02</span>
                <div class="lx-item__text-content">
                    <h3 class="lx-item__name">Cheveux</h3>
                    <p class="lx-item__sub">Régénération Capillaire</p>
                </div>
                <p class="lx-item__desc">Protocoles de PRP et soins spécialisés pour le cuir chevelu et la densité capillaire.</p>
                <a href="/Home/Hair" class="lx-item__cta">Découvrir <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></a>
            </div>
        </div>

        <div class="lx-item" data-index="03" data-label="Corps">
            <div class="lx-item__bar"></div>
            <div class="lx-item__visual">
                <img src="/images/body.png" alt="Corps">
                <div class="lx-img-overlay"></div>
                <div class="lx-img-label">Corps</div>
            </div>
            <div class="lx-item__inner">
                <span class="lx-item__num">03</span>
                <div class="lx-item__text-content">
                    <h3 class="lx-item__name">Corps & Peau</h3>
                    <p class="lx-item__sub">Dermatologie Clinique</p>
                </div>
                <p class="lx-item__desc">Dermatologie médicale, chirurgicale et pédiatrique pour une santé cutanée optimale.</p>
                <a href="/Home/Body" class="lx-item__cta">Découvrir <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></a>
            </div>
        </div>

        <div class="lx-item" data-index="04" data-label="Laser">
            <div class="lx-item__bar"></div>
            <div class="lx-item__visual">
                <img src="/images/laser.png" alt="Laser">
                <div class="lx-img-overlay"></div>
                <div class="lx-img-label">Laser</div>
            </div>
            <div class="lx-item__inner">
                <span class="lx-item__num">04</span>
                <div class="lx-item__text-content">
                    <h3 class="lx-item__name">Laser & Tech</h3>
                    <p class="lx-item__sub">Précision Photonique</p>
                </div>
                <p class="lx-item__desc">Épilation définitive, détatouage et rajeunissement par les technologies laser les plus avancées.</p>
                <a href="/Home/Laser" class="lx-item__cta">Découvrir <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></a>
            </div>
        </div>
    </div>
</section>

<section class="metamorphosis-lab section-padding" id="resultats">
    <div class="lab-container-edge">
        <header class="lab-header reveal-on-scroll">
            <div class="lab-badge">RAPPORTS CLINIQUES</div>
            <h2 class="lab-title">RÉSULTATS <em>MÉDICAUX</em></h2>
            <p class="lab-lead">Découvrez nos cas cliniques et images avant/après des protocoles de traitement.</p>
            <div class="lab-divider"></div>
        </header>

        <!-- Full-Width Edge-to-Edge Slider Container with Floating Side Arrows -->
        <div class="full-slider-wrapper-edge">
            <button class="slider-arrow-btn slider-arrow-left" id="labPrevBtn" aria-label="Précédent" title="Cas Précédent">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>

            <div class="lab-carousel-scroller" id="labScroller">
                @if (Model.Results != null && Model.Results.Any())
                {
                    double delay = 0;
                    foreach (var res in Model.Results)
                    {
                        <article class="transformation-card reveal-on-scroll" style="transition-delay: @(delay)s;">
                            <div class="transformation-visual">
                                <div class="image-pair">
                                    <div class="img-before" style="background-image: url('@res.BeforeImageUrl');">
                                        <span class="img-label">AVANT</span>
                                    </div>
                                    <div class="img-after" style="background-image: url('@res.AfterImageUrl');">
                                        <span class="img-label">APRÈS</span>
                                    </div>
                                </div>
                                <div class="transformation-scan-line"></div>
                            </div>
                            <div class="transformation-info">
                                <div class="info-header">
                                    <span class="info-case">ID DU CAS : #@res.Id.ToString("D4")</span>
                                    <span class="info-protocol">@res.ProtocolName</span>
                                </div>
                                <h3 class="info-title">@res.Title</h3>
                                <p class="info-desc">@res.Description</p>
                            </div>
                        </article>
                        delay += 0.15;
                    }
                }

                <!-- Showcase Clinical Cards with Real AI Face & Hair Before/After Photos -->
                <article class="transformation-card reveal-on-scroll" style="transition-delay: 0.3s;">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/before_face_1.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/after_face_1.png');">
                                <span class="img-label">APRÈS</span>
                            </div>
                        </div>
                        <div class="transformation-scan-line"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #0821</span>
                            <span class="info-protocol">ARCHITECTURE HYALURONIQUE & BOTOX</span>
                        </div>
                        <h3 class="info-title">Sculpture Volumétrique & Rajeunissement Facial</h3>
                        <p class="info-desc">Restauration des volumes de la pommette, lissage des rides du contour des yeux et éclat cutané instantané.</p>
                    </div>
                </article>

                <article class="transformation-card reveal-on-scroll" style="transition-delay: 0.45s;">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/before_laser_2.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/after_laser_2.png');">
                                <span class="img-label">APRÈS</span>
                            </div>
                        </div>
                        <div class="transformation-scan-line"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #1042</span>
                            <span class="info-protocol">LASER CO2 FRACTIONNÉ</span>
                        </div>
                        <h3 class="info-title">Resurfacing Cutané & Élimination des Taches</h3>
                        <p class="info-desc">Lissage des micro-reliefs cutanés, réduction des pores dilatés et unification parfaite du teint.</p>
                    </div>
                </article>

                <article class="transformation-card reveal-on-scroll" style="transition-delay: 0.6s;">
                    <div class="transformation-visual">
                        <div class="image-pair">
                            <div class="img-before" style="background-image: url('/images/before_hair_3.png');">
                                <span class="img-label">AVANT</span>
                            </div>
                            <div class="img-after" style="background-image: url('/images/after_hair_3.png');">
                                <span class="img-label">APRÈS</span>
                            </div>
                        </div>
                        <div class="transformation-scan-line"></div>
                    </div>
                    <div class="transformation-info">
                        <div class="info-header">
                            <span class="info-case">ID DU CAS : #0915</span>
                            <span class="info-protocol">PRP & REGENERA ACTIVA CAPILLAIRE</span>
                        </div>
                        <h3 class="info-title">Redensification Capillaire & Alopécie</h3>
                        <p class="info-desc">Stimulation autologue des follicules pileux pour arrêter la chute et régénérer la densité de la chevelure.</p>
                    </div>
                </article>
            </div>

            <button class="slider-arrow-btn slider-arrow-right" id="labNextBtn" aria-label="Suivant" title="Cas Suivant">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </button>
        </div>

        <div class="lab-footer reveal-on-scroll">
            <a href="/Home/Results" class="cta-lab-btn">VOIR LE REGISTRE SCIENTIFIQUE COMPLET</a>
        </div>
    </div>
</section>

<section id="journal" class="edit-section">
    <div class="edit-header reveal-on-scroll">
        <p class="edit-header__eyebrow">ACTUALITÉ MÉDICALE</p>
        <h2 class="edit-header__title">PUBLICATIONS & CAS CLINIQUES</h2>
    </div>

    <div class="edit-grid">
        @if (Model.Articles != null && Model.Articles.Any())
        {
            float delay = 0;
            foreach (var art in Model.Articles)
            {
                <article class="edit-card reveal-on-scroll" style="transition-delay: @(delay)s; cursor: pointer;" onclick="location.href='/Home/Article/@art.Id'">
                    <div class="edit-card__img-wrap">
                        <img src="@art.CoverImageUrl" class="edit-card__img" alt="@art.Title">
                    </div>
                    <div class="edit-card__overlay">
                        <span class="edit-card__cat">@art.CategoryName</span>
                        <h3 class="edit-card__title" style="cursor: pointer;">@art.Title</h3>
                        <a href="/Home/Article/@art.Id" class="edit-card__cta">LIRE L'ÉDITO</a>
                    </div>
                </article>
                delay += 0.15f;
            }
        }
        else
        {
            <!-- Fallback Article -->
            <article class="edit-card reveal-on-scroll">
                <div class="edit-card__img-wrap">
                    <img src="/images/article1.jpg" class="edit-card__img" alt="The French Touch">
                </div>
                <div class="edit-card__overlay">
                    <span class="edit-card__cat">L'ART DE L'INJECTION</span>
                    <h3 class="edit-card__title">La "French Touch" : L'Invisibilité au service de la Beauté</h3>
                    <a href="/Home/Article" class="edit-card__cta">LIRE L'ÉDITO</a>
                </div>
            </article>
        }
    </div>
    <div class="edit-footer reveal-on-scroll" style="text-align: center; margin-top: 5rem;">
        <a asp-controller="Home" asp-action="Journal" class="cta-lab-btn">VOIR TOUTES LES PUBLICATIONS</a>
    </div>
</section>

<div class="arch-divider"></div>

<section class="artistic-cta reveal-on-scroll">
    <div class="cta-inner">
        <span class="cta-eyebrow">EXCELLENCE SIGNATURE</span>
        <div class="cta-ornament"></div>
        <h2 class="cta-title">RÉVÉLEZ VOTRE <br> ÉCLAT ORIGINEL</h2>
        <p class="cta-subtitle">Commencez votre voyage vers l'harmonie esthétique avec une consultation clinique personnalisée dans notre établissement d'élite.</p>
