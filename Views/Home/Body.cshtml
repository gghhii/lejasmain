@model IEnumerable<DrAshrafMellouli.Models.Treatment>
@{
    ViewData["Title"] = "Corps & Peau - Les Jasmins";
}
<!-- ATMOSPHERIC JOURNEY NAVIGATION: FLOATING GLASS PILL -->
<div class="journey-glass-nav" id="journeyNav">
    <a href="#hero" class="journey-link active" data-section="hero">ACCUEIL</a>
    <a href="#protocols" class="journey-link" data-section="protocols">TRAITEMENTS</a>
    <a href="#expertise" class="journey-link" data-section="expertise">TECHNOLOGIES</a>
    <a href="#results" class="journey-link" data-section="results">RÉSULTATS</a>
    <a href="#journey" class="journey-link" data-section="journey">DÉROULEMENT</a>
    <a href="#faq" class="journey-link" data-section="faq">FAQ</a>
</div>

<section id="hero" class="treatment-clinical-split">
    <div class="clinical-split-sculpture">
        <!-- Left Side: Technical Data -->
        <div class="clinical-data-column reveal-on-scroll">
            <div class="data-badge">PROTOCOLE : CORPS</div>
            <div class="data-readout">
                <span>COORD : 54.122</span>
                <span>TYPE : REMODELAGE</span>
                <span>v2.8.1</span>
            </div>
            <h1 class="clinical-title">
                FORME <br>
                <span class="gold-italic">SCULPTÉE</span>
            </h1>
            <p class="clinical-lead">
                Affinage non invasif de la silhouette et raffermissement des tissus utilisant les technologies de remodelage corporel les plus avancées au monde.
            </p>
            
            <div class="clinical-abstract-mesh"></div>
        </div>

        <!-- Right Side: Ethereal Portrait -->
        <div class="clinical-visual-column">
            <img class="clinical-portrait-img" src="/images/body.png" alt="Body Treatment">
            <div class="visual-scan-line"></div>
            <div class="visual-topo-overlay"></div>
            <div class="visual-corner-tags">
                <span>MORPHOLOGIE</span>
                <span>SYMMÉTRIE</span>
            </div>
        </div>

    </div>

    <div class="clinical-scroll-indicator">
        <span class="scroll-label">PROTOCOLES SÉLECTIONNÉS</span>
        <div class="scroll-monolith-line"></div>
    </div>
</section>


<section id="protocols" class="treatment-gallery-sculpture section-padding">
    <div class="gallery-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">TRAITEMENTS <br> <em>CORPORELS</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="treatment-discovery-bar reveal-on-scroll">
            <div class="search-wrapper">
                <input type="text" class="search-input" placeholder="RECHERCHER UN SOIN..." id="bodySearch">
                <div class="search-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
                <div class="search-scanner-line"></div>
            </div>
        </div>

        <div class="treatment-matrix">
            @if (Model != null && Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <div class="matrix-item reveal-on-scroll" style="transition-delay: @(0.1 * (i-1))s;">
                        <div class="matrix-visual">
                            <img src="@item.ImageUrl" alt="@item.Title">
                            <div class="matrix-overlay"></div>
                            <span class="matrix-num">@i.ToString("D2")</span>
                        </div>
                        <div class="matrix-content">
                            <h3 class="matrix-name">@item.Title</h3>
                            <p class="matrix-desc">@item.Description</p>
                            <a href="/Home/Treatment/@item.Id" class="matrix-link">DÉTAILS DU PROTOCOLE →</a>
                        </div>
                    </div>
                    i++;
                }
            }
            else
            {
                <!-- Fallback to static if no data in DB yet -->
                <!-- 1: Traitement Médical et Chirurgical de la Peau -->
                <div class="matrix-item reveal-on-scroll">
                    <div class="matrix-visual">
                        <img src="/images/medical_body.png" alt="Peau">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">01</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">TRAITEMENT MÉDICAL ET CHIRURGICAL DE LA PEAU</h3>
                        <p class="matrix-desc">Prise en charge complète des pathologies cutanées complexes.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- 2: Dermatologie Pédiatrique -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.1s;">
                    <div class="matrix-visual">
                        <img src="https://images.unsplash.com/photo-1584515933487-779824d29309?q=80&w=2070&auto=format&fit=crop" alt="Pédiatrie">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">02</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">DERMATOLOGIE PÉDIATRIQUE</h3>
                        <p class="matrix-desc">Soins dermatologiques adaptés aux nourrissons et enfants.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- 3: Traitement des Maladies Sexuellement Transmissibles -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.2s;">
                    <div class="matrix-visual">
                        <img src="https://images.unsplash.com/photo-1579154341098-e4e158cc7f55?q=80&w=2070&auto=format&fit=crop" alt="MST">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">03</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">TRAITEMENT DES MALADIES SEXUELLEMENT TRANSMISSIBLES</h3>
                        <p class="matrix-desc">Diagnostic et traitement confidentiel des MST.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>

                <!-- 4: Vénéréologie -->
                <div class="matrix-item reveal-on-scroll" style="transition-delay: 0.3s;">
                    <div class="matrix-visual">
                        <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?q=80&w=2080&auto=format&fit=crop" alt="Vénéréologie">
                        <div class="matrix-overlay"></div>
                        <span class="matrix-num">04</span>
                    </div>
                    <div class="matrix-content">
                        <h3 class="matrix-name">VÉNÉRÉOLOGIE</h3>
                        <p class="matrix-desc">Spécialité médicale dédiée aux infections génitales.</p>
                        <a href="#" class="matrix-link">DÉTAILS DU PROTOCOLE</a>
                    </div>
                </div>
            }
        </div>


        <div id="noBodyResults" class="no-results-msg">Aucun soin ne correspond à votre recherche.</div>

        <script>
            document.getElementById('bodySearch').addEventListener('input', function(e) {
                const term = e.target.value.toLowerCase();
                const items = document.querySelectorAll('.matrix-item');
                let hasResults = false;
                
                items.forEach(item => {
                    const title = item.querySelector('.matrix-name').textContent.toLowerCase();
                    const desc = item.querySelector('.matrix-desc').textContent.toLowerCase();
                    
                    if (title.includes(term) || desc.includes(term)) {
                        item.classList.remove('hidden');
                        hasResults = true;
                    } else {
                        item.classList.add('hidden');
                    }
                });
                
                document.getElementById('noBodyResults').style.display = hasResults ? 'none' : 'block';
            });
        </script>
    </div>
</section>

</section>
<section id="expertise" class="tech-metrics-section">
    <div class="gallery-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">TECHNOLOGIES <br> <em>& APPAREILS</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="metrics-grid">
            <div class="metric-card reveal-on-scroll">
                <span class="metric-num">MESURE 01</span>
                <h3 class="metric-title">PRÉCISION THERMIQUE</h3>
                <p class="metric-desc">Utilisation de changements de température contrôlés pour cibler sélectivement le tissu adipeux sans affecter la peau environnante.</p>
            </div>
            <div class="metric-card reveal-on-scroll" style="transition-delay: 0.1s;">
                <span class="metric-num">MESURE 02</span>
                <h3 class="metric-title">TECH BIOSCULPT</h3>
                <p class="metric-desc">Systèmes avancés de HIFU et de radiofréquence qui travaillent en synergie pour raffermir les couches dermiques et dissoudre les graisses.</p>
            </div>
            <div class="metric-card reveal-on-scroll" style="transition-delay: 0.2s;">
                <span class="metric-num">MESURE 03</span>
                <h3 class="metric-title">RÉSULTATS BASÉS SUR LES DONNÉES</h3>
                <p class="metric-desc">Chaque plan de traitement s'appuie sur des mesures précises et une cartographie clinique de votre silhouette.</p>
            </div>
        </div>
    </div>
</section>

</section>

<section id="results" class="transformation-showcase section-padding">
    <div class="showcase-container">
        <header class="showcase-header reveal-on-scroll">
            <span class="showcase-label">ÉTUDE DE CAS: #B-712</span>
            <h2 class="showcase-title">MORPHOLOGIE <br> <em>REDESSINÉE</em></h2>
        </header>

        <div class="cinematic-reveal reveal-on-scroll">
            <img src="/images/body_transformation.png" alt="Body Transformation">
            <div class="reveal-labels">
                <span class="reveal-label">AVANT</span>
                <span class="reveal-label">APRÈS</span>
            </div>
        </div>

        <div class="showcase-footer reveal-on-scroll">
            <div class="footer-metadata">
                <span class="metadata-item">PROTOCOLE: <span>CRYOLIPOLYSE 360°</span></span>
                <span class="metadata-item">CIBLES: <span>ABDOMEN & TAILLE</span></span>
                <span class="metadata-item">RÉSULTAT: <span>DÉFINITIF</span></span>
            </div>
            <a href="/Home/Results" class="showcase-cta">EXPLOREZ LES CASES STUDIES →</a>
        </div>
    </div>
</section>

</section>

<section id="journey" class="procedure-journey">
    <div class="journey-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">DÉROULEMENT <br> <em>DU SOIN</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="journey-steps">
            <div class="journey-step reveal-on-scroll">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 01</span>
                <h3 class="step-title">DIAGNOSTIC</h3>
                <p class="step-text">Analyse complète de la densité tissulaire, de la répartition des graisses et des marqueurs d'élasticité cutanée.</p>
            </div>
            <div class="journey-step reveal-on-scroll" style="transition-delay: 0.1s;">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 02</span>
                <h3 class="step-title">CALIBRATION</h3>
                <p class="step-text">Ajustement de nos dispositifs médicaux aux profondeurs et intensités spécifiques requises pour vos objectifs.</p>
            </div>
            <div class="journey-step reveal-on-scroll" style="transition-delay: 0.2s;">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 03</span>
                <h3 class="step-title">TRAITEMENT</h3>
                <p class="step-text">Application d'énergie photonique ou ultrasonique dans un environnement clinique relaxant.</p>
            </div>
            <div class="journey-step reveal-on-scroll" style="transition-delay: 0.3s;">
                <div class="step-line"></div>
                <div class="step-dot"></div>
                <span class="step-label">PHASE 04</span>
                <h3 class="step-title">AFFINAGE</h3>
                <p class="step-text">Élimination métabolique naturelle des cellules traitées au cours des semaines suivantes, révélant votre nouvelle forme.</p>
            </div>
        </div>
    </div>
</section>

</section>

<section id="faq" class="faq-clinical">
    <div class="faq-container">
        <header class="gallery-header reveal-on-scroll">
            <h2 class="gallery-title">QUESTIONS <br> <em>FRÉQUENTES</em></h2>
            <div class="gallery-line"></div>
        </header>

        <div class="faq-list">
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Le remodelage corporel est-il une solution de perte de poids ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        Non, ces traitements sont conçus pour une réduction localisée des graisses et un raffermissement de la peau. C'est idéal pour les zones "tenaces" qui ne répondent pas au régime ou à l'exercice, plutôt que pour une perte de poids générale.
                    </div>
                </div>
            </div>
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Les résultats sont-ils permanents ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        Les cellules graisseuses traitées sont éliminées de façon permanente. Cependant, le maintien d'un mode de vie sain est essentiel pour empêcher les cellules graisseuses restantes de se dilater et pour garder la peau ferme.
                    </div>
                </div>
            </div>
            <div class="faq-item reveal-on-scroll">
                <button class="faq-question">
                    <span class="faq-q-text">Combien de séances sont généralement nécessaires ?</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <div class="faq-a-content">
                        La philosophie du centre Les Jasmins, dirigé par le Dr Ashraaf Mellouli Laroussi, intègre une prise en charge globale de la santé de la peau, qu'il s'agisse de dermatologie clinique, pédiatrique ou esthétique.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

